# ------------------------------------------------------------------
# Sunny Campus - server environment
# Copy this file to ".env" and fill in your Aiven MySQL details.
# ------------------------------------------------------------------

PORT=5000

# Use a long random string in production
JWT_SECRET=replace-me-with-a-long-random-secret

# ------------------------------------------------------------------
# Option 1 (easiest): paste the MySQL service URI from console.aiven.io
# Example: mysql://avnadmin:password@mysql-xxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
# ------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------
# Option 2: use individual connection values (used when DATABASE_URL is empty)
# ------------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=

# Name of the database that contains the SMS tables.
# This overrides the database name in DATABASE_URL, so it can stay "sms"
# even if the Aiven URI ends with /defaultdb.
DB_NAME=sms

# Aiven needs SSL. Set to true for Aiven, false for a local MySQL server.
DB_SSL=true

# Where the React app runs (used for CORS)
CLIENT_ORIGIN=http://localhost:5173
